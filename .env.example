# ==============================================================================
# SWASTHYA HEALTHCARE COMPANION - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit .env to version control or expose service-role/secret keys to clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4173
HOST=0.0.0.0
NODE_ENV=production
# Generate a random 64-character hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=your_super_strong_session_secret_change_me_in_production

# ------------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL Database & Authentication)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Public Key: Safe to share with frontend client
SUPABASE_ANON_KEY=eyJhbGciOi...your_supabase_anon_key
# Service Role Key: BACKEND ONLY. Never expose in frontend code or Git repo.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Secure Medical Photo & Report Storage)
# ------------------------------------------------------------------------------
# Found in: Cloudinary Dashboard -> API Keys & Cloud name
# Uploads occur through the backend only. Secrets are NEVER sent to the browser.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. ONESIGNAL (Background Push Reminders & Quotes)
# ------------------------------------------------------------------------------
# Found in: OneSignal Dashboard -> Settings -> Keys & IDs
# App ID: Used by frontend Web SDK and backend push dispatcher
ONESIGNAL_APP_ID=your_onesignal_app_id
# REST API Key: BACKEND ONLY. Used by backend to dispatch background push notifications
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# ------------------------------------------------------------------------------
# 5. OPENAI (Real AI Health Assistant)
# ------------------------------------------------------------------------------
# Found in: OpenAI Platform -> API keys
# BACKEND ONLY. Never exposed in frontend client code.
OPENAI_API_KEY=sk-proj-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

